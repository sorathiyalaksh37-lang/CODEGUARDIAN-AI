# Server Configuration
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas - Get your connection string from MongoDB Atlas
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/codeguardian?retryWrites=true&w=majority

# JWT Authentication - Use a strong secret key
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# GitHub OAuth - Get from https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
GITHUB_TOKEN=your_github_personal_access_token

# Groq AI - Get from https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# OpenRouter API (optional)
OPENROUTER_API_KEY=your_openrouter_api_key

# Session Secret - Use a strong secret key
SESSION_SECRET=your_session_secret_key

# Redis
REDIS_URL=redis://localhost:6379
